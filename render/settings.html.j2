<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Settings</title>
<link rel="stylesheet" href="theme.css?v={{ asset_v }}">
{% include '_theme.html.j2' %}
<style>
  /* page-specific only; theme.css is shared */
  .banner{border:1px solid var(--warn-line);background:var(--warn-bg);color:var(--warn-ink);
    border-radius:var(--radius);padding:10px 14px;font-size:13px;margin:14px 0 0}
  body.live .banner.readonly{display:none}
  #livebadge{display:none}
  .file{font-family:var(--mono);font-size:12px;color:var(--ink-mute);margin:-12px 0 18px}
  .setgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .setgrid .wide{grid-column:1 / -1}
  .card h3{font-size:15px;margin:0 0 4px}
  .card .help{font-size:12px;color:var(--ink-mute);margin:0 0 10px}
  .items{display:flex;flex-direction:column;gap:6px}
  .item{display:flex;gap:6px;align-items:center}
  .item .n{font-family:var(--mono);font-size:12px;color:var(--ink-mute);min-width:22px;text-align:right}
  .item .textfield{flex:1;min-width:0}
  .item .pages{flex:0 0 78px}
  .mini{font-size:12px;font-family:var(--sans);border:1px solid var(--line);background:var(--bg-card);
    color:var(--ink-dim);border-radius:6px;padding:3px 8px;cursor:pointer;line-height:1.2}
  .mini:hover{border-color:var(--ink-mute);color:var(--ink)}
  .mini:disabled{opacity:.4;cursor:default}
  .card textarea.textfield{width:100%;box-sizing:border-box;min-height:120px;font-family:var(--sans);
    font-size:13px;padding:8px;resize:vertical}
  .card .textfield{max-width:none}          /* theme.css caps it for the tracker's cells */
  .card input.textfield{padding:5px 8px;font-size:13px}
  .card .item .pages{max-width:78px}
  .savebar{display:flex;gap:8px;align-items:center;margin-top:10px;font-size:12px;color:var(--ink-mute)}
  .save{font-size:12px;font-weight:600;font-family:var(--sans);border:1px solid var(--accent);
    background:var(--accent-soft);color:var(--accent);border-radius:6px;padding:4px 12px;cursor:pointer}
  .save:disabled{opacity:.5;cursor:default}
  body:not(.live) .save,body:not(.live) .mini{display:none}
  .dirty .save{background:var(--accent);color:var(--bg-card)}
  .field{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}
  .field label{font-size:13px;color:var(--ink);font-weight:500}
  .note{font-size:12px;color:var(--ink-mute)}
  h3.sub{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-mute);margin:26px 0 10px;font-weight:600}
  .rule{border:1px solid var(--line);border-radius:var(--radius);padding:8px 10px;background:var(--bg-card)}
  .rule .row{display:flex;gap:6px;align-items:flex-start}
  .rule textarea.textfield{min-height:54px;flex:1}
  .rule select{font-size:12px;font-family:var(--sans);border:1px solid var(--line);background:var(--bg-card);
    color:var(--ink-dim);border-radius:6px;padding:3px 4px}
  .rule .ev{font-size:12px;color:var(--ink-mute);margin:6px 0 0}
  .rule.pending{border-style:dashed}
  .rule.adopted{opacity:.55}
  .rules{display:flex;flex-direction:column;gap:8px}
  .draftbox{margin-top:14px;padding-top:12px;border-top:1px dashed var(--line)}
  .draftbox h4{font-size:13px;margin:0 0 4px}
  .facts{margin:0;padding-left:18px;font-size:13px;color:var(--ink-dim)}
  .facts li{margin:3px 0}
  .facts b{color:var(--ink)}
  details.peek{margin-top:10px}
  details.peek summary{cursor:pointer;font-size:13px;color:var(--ink-dim)}
  details.peek pre{white-space:pre-wrap;font-family:var(--mono);font-size:12px;line-height:1.5;
    background:var(--bg-card);border:1px solid var(--line);border-radius:var(--radius);padding:10px;
    max-height:420px;overflow:auto;margin:8px 0 0}
  body:not(.live) .rule .mini,body:not(.live) .rule select{display:none}
  @media(max-width:800px){.setgrid{grid-template-columns:1fr}}
</style></head>
<body>

{% with page='settings', subtitle='Settings' %}{% include '_nav.html.j2' %}{% endwith %}

<div class="wrap">
  <header class="masthead">
    <div class="eyebrow">Workspace · {{ workspace_name }}</div>
    <h1>Settings</h1>
    <p class="standfirst">What the Tracker, the Content Radar and the Profile review read. Each card saves to the file named
    above it. Nothing re-runs on save: the next <code>mc run</code> or <code>mc profile</code> picks it up.</p>
    <div class="chips" style="margin-top:18px"><span class="chip live" id="livebadge">Live · edits save</span></div>
    <div class="banner readonly">Read-only copy. Start <code>mc dashboard</code> and open this page from it to edit.</div>
  </header>

  <section>
    <div class="sec-label"><b>01</b>Tracker</div>
    <h2>What you want, and how roles are judged</h2>
    <p class="file">me/profile.md · the previous version is kept as me/profile.prev.md · the last two cards are in workspace/{{ workspace_name }}/config/profile.yaml</p>
    <div class="setgrid" id="tracker"></div>
  </section>

  <section>
    <div class="sec-label"><b>02</b>Content Radar</div>
    <h2>What to write about, and how</h2>
    <p class="file">me/profile.md · the previous version is kept as me/profile.prev.md</p>
    <div class="setgrid" id="radar"></div>
  </section>

  <section>
    <div class="sec-label"><b>03</b>Profile</div>
    <h2>Whose public profiles to read, and when</h2>
    <p class="file">handles in workspace/{{ workspace_name }}/.env · sites and time windows in workspace/{{ workspace_name }}/config/profile.yaml, which overrides the repo's default</p>
    <div class="setgrid" id="profile"></div>
    <p class="note" style="margin-top:12px">The BlueSky app password is
    {% if settings.accounts.bluesky_app_password_set %}set{% else %}not set{% endif %}. It is only a fallback
    for when the public read fails, and it is edited in the file, never here.</p>
  </section>

  <section>
    <div class="sec-label"><b>04</b>Fit rules</div>
    <h2>Every rule the models follow</h2>
    <p class="file">Your notes and exclude keywords are edited under Tracker. The learned rules are in me/learned.md and me/profile-guidance.md. Each is shown here exactly as the model reads it, and nothing is used until it is in the approved list.</p>

    <h3 class="sub">Job fit</h3>
    <div class="setgrid" id="rules-job"></div>

    <div class="setgrid" style="margin-top:14px">
      <article class="card">
        <h3>Fixed rules</h3>
        <p class="help">Applied by code, before or around the model.</p>
        <ul class="facts">
          <li><b>Exclude keywords</b> ({{ overview.fixed.exclude_keywords }}): a match in a role's title drops it before any model call.</li>
          <li><b>Target keywords</b> ({{ overview.fixed.target_keywords }}): raise a role's score on a match in its title or description, and become board searches.</li>
          <li><b>Minimum match score</b>: {{ overview.fixed.min_match_score if overview.fixed.min_match_score is not none else 'not set' }}, the only threshold. Set in config/job-sources.yaml.</li>
          <li><b>Live roles judged per run</b>: up to {{ overview.fixed.max_live_roles if overview.fixed.max_live_roles is not none else 200 }}.</li>
        </ul>
      </article>
      <article class="card">
        <h3>How learned preferences are drawn</h3>
        <p class="help">From the roles you close or pursue. Python counts, then one model call words the rules.</p>
        <ul class="facts">
          <li><b>Window:</b> decisions from the last {{ overview.learning.window_days }} days.</li>
          <li><b>Pursued</b> means a role you are {{ overview.learning.pursued_statuses|join(' or ') }}, or one an employer has responded on.</li>
          <li><b>Passed</b> counts only when the close reason is about the role: {{ overview.learning.count_close|join(', ') }}.</li>
          <li><b>Ignored:</b> {{ overview.learning.ignore_close|join(', ') }}, and a close with no reason.</li>
          <li>A group needs {{ overview.learning.min_decisions }} decisions and {{ overview.learning.min_leaning }} on the side it leans to. Its pursue rate must fall below {{ overview.learning.avoid_ratio }}× or rise above {{ overview.learning.seek_ratio }}× your overall rate.</li>
          <li>A pattern the model already follows is left out: you must have overridden it on at least {{ overview.learning.min_disagreements }} roles.</li>
          <li>A new draft is written every {{ overview.learning.draft_days }} days. It changes nothing until you adopt it.</li>
        </ul>
      </article>
    </div>

    <details class="peek"><summary>What the fit judge reads ({{ '{:,}'.format(overview.fit_prompt|length) }} characters): your profile, notes, resume, approved rules and instructions</summary>
      <pre>{{ overview.fit_prompt }}</pre></details>

    <h3 class="sub">Profile review</h3>
    <div class="setgrid" id="rules-profile"></div>

    <div class="setgrid" style="margin-top:14px">
      <article class="card">
        <h3>What the review judges</h3>
        <p class="help">Each source gets a score on these.</p>
        <ul class="facts">
          {% for k, v in overview.dimensions.items() %}<li><b>{{ k|capitalize }}:</b> {{ v }}.</li>{% endfor %}
        </ul>
      </article>
      <article class="card">
        <h3>How review guidance is drawn</h3>
        <p class="help">From the findings you dismiss on the Profile page.</p>
        <ul class="facts">
          <li>A group of dismissals without reasons needs {{ overview.learning.guidance_min_dismissals }} of them, and at least {{ (overview.learning.guidance_min_share * 100)|round|int }}% of its findings dismissed rather than accepted or fixed.</li>
          <li>A dismissal with a reason can become a rule on its own.</li>
          <li>A new draft is written when your dismissals change. It changes nothing until you adopt it.</li>
        </ul>
      </article>
    </div>

    <details class="peek"><summary>What the profile reviewer reads as guidance</summary>
      <pre>{{ overview.guidance_prompt or '(no approved guidance yet)' }}</pre></details>
  </section>
</div>

<script id="settings-data" type="application/json">{{ {'settings': settings, 'spec': spec, 'limits': review_limits, 'maxSites': max_sites, 'maxPages': max_site_pages, 'trackerReview': tracker_review_keys}|tojson }}</script>
<script>
(function(){
  var D = JSON.parse(document.getElementById('settings-data').textContent);
  var S = D.settings;
  var live = false, API = window.location.origin;

  function el(tag, attrs, kids){
    var e = document.createElement(tag);
    Object.keys(attrs || {}).forEach(function(k){
      if(k === 'text') e.textContent = attrs[k]; else if(k === 'cls') e.className = attrs[k]; else e.setAttribute(k, attrs[k]);
    });
    (kids || []).forEach(function(c){ if(c) e.appendChild(c); });
    return e;
  }

  // One card: a heading, help text, an editor, and a Save button. `read()`
  // returns what to send; the server's answer (normalised) is fed back to `load`.
  function card(host, opts){
    var flash = el('span', {cls: 'flash'});
    var save = el('button', {type: 'button', cls: 'save', text: 'Save'});
    var c = el('article', {cls: 'card' + (opts.wide ? ' wide' : '')}, [
      el('h3', {text: opts.title}), opts.help ? el('p', {cls: 'help', text: opts.help}) : null,
      opts.body, el('div', {cls: 'savebar'}, [save, opts.counter || null, flash])]);
    c.addEventListener('input', function(){ c.classList.add('dirty'); flash.textContent = ''; });
    c.addEventListener('mc-change', function(){ c.classList.add('dirty'); flash.textContent = ''; });
    save.addEventListener('click', function(){
      save.disabled = true;
      fetch(API + '/api/settings', {method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({group: opts.group, field: opts.field, value: opts.read()})})
      .then(function(r){ return r.json().then(function(j){ return r.ok ? j : Promise.reject(j); }); })
      .then(function(j){
        opts.load(j.value); c.classList.remove('dirty');
        flash.className = 'flash saved'; flash.textContent = j.changed ? 'saved' : 'no change';
      })
      .catch(function(err){ flash.className = 'flash failed'; flash.textContent = (err && err.error) || 'failed'; })
      .finally(function(){ save.disabled = false; });
    });
    host.appendChild(c);
    return c;
  }

  // A reorderable list of text inputs. `row(value)` makes the inputs for one item.
  function listEditor(values, row, max, numbered){
    var box = el('div', {cls: 'items'});
    var add = el('button', {type: 'button', cls: 'mini', text: '+ Add'});
    function renumber(){
      Array.prototype.forEach.call(box.children, function(r, i){
        var n = r.querySelector('.n'); if(n) n.textContent = numbered ? (i + 1) + '.' : '';
        r.querySelector('.up').disabled = i === 0;
        r.querySelector('.down').disabled = i === box.children.length - 1;
      });
      add.disabled = box.children.length >= max;
      box.dispatchEvent(new Event('mc-change', {bubbles: true}));
    }
    function addRow(value, focus){
      var inputs = row(value);
      var up = el('button', {type: 'button', cls: 'mini up', title: 'Move up', text: '↑'});
      var down = el('button', {type: 'button', cls: 'mini down', title: 'Move down', text: '↓'});
      var del = el('button', {type: 'button', cls: 'mini', title: 'Remove', text: '×'});
      var r = el('div', {cls: 'item'}, [numbered ? el('span', {cls: 'n'}) : null].concat(inputs, [up, down, del]));
      up.onclick = function(){ if(r.previousSibling) box.insertBefore(r, r.previousSibling); renumber(); };
      down.onclick = function(){ if(r.nextSibling) box.insertBefore(r.nextSibling, r); renumber(); };
      del.onclick = function(){ r.remove(); renumber(); };
      inputs[0].addEventListener('keydown', function(e){
        if(e.key === 'Enter'){
          e.preventDefault();
          if(box.children.length < max){
            var nr = addRow('');
            box.insertBefore(nr, r.nextSibling); nr.querySelector('input').focus(); renumber();
          }
        }
      });
      box.appendChild(r);
      if(focus) inputs[0].focus();
      return r;
    }
    add.onclick = function(){ addRow('', true); renumber(); };
    function load(vals){ box.innerHTML = ''; (vals || []).forEach(function(v){ addRow(v); }); renumber(); }
    load(values);
    return {body: el('div', {}, [box, el('div', {style: 'margin-top:8px'}, [add])]), box: box, load: load};
  }

  function textInput(value, cap){
    var i = el('input', {type: 'text', cls: 'textfield', maxlength: cap});
    i.value = value && value.url !== undefined ? value.url : (value || '');
    return i;
  }

  // ---- 01 Tracker, 02 Content Radar (sections of me/profile.md)
  var hosts = {tracker: document.getElementById('tracker'), radar: document.getElementById('radar')};
  D.spec.forEach(function(sp){
    var key = sp.key, value = S.goals[key], goals = hosts[sp.section] || hosts.tracker;
    if(sp.kind === 'text'){
      var ta = el('textarea', {cls: 'textfield', maxlength: sp.cap});
      ta.value = value || '';
      var cnt = el('span', {cls: 'count'});
      function count(){ cnt.textContent = ta.value.length + ' / ' + sp.cap; }
      ta.addEventListener('input', count); count();
      card(goals, {group: 'goals', field: key, title: sp.heading, help: sp.help, body: ta, counter: cnt,
        wide: true, read: function(){ return ta.value; }, load: function(v){ ta.value = v; count(); }});
    } else {
      var ed = listEditor(value, function(v){ return [textInput(v, sp.cap)]; }, sp.max, sp.kind === 'numbered');
      card(goals, {group: 'goals', field: key, title: sp.heading, help: sp.help, body: ed.body,
        wide: key === 'watch_topics',
        read: function(){
          return Array.prototype.map.call(ed.box.querySelectorAll('input'), function(i){ return i.value; });
        }, load: ed.load});
    }
  });

  // ---- 03 Profile: handles, sites, time windows
  var profile = document.getElementById('profile');
  [['github_username', 'GitHub username', 'Public repos and your profile README. Blank skips the GitHub scan.'],
   ['bluesky_handle', 'BlueSky handle', 'e.g. name.bsky.social. Blank skips the BlueSky scan.']].forEach(function(a){
    var i = textInput(S.accounts[a[0]], 253);
    card(profile, {group: 'accounts', field: a[0], title: a[1], help: a[2], body: i,
      read: function(){ return i.value; }, load: function(v){ i.value = v; }});
  });
  var sites = listEditor(S.review.sites, function(v){
    var u = textInput(v, 500); u.placeholder = 'https://you.example/';
    var p = el('input', {type: 'number', cls: 'textfield pages', min: 0, max: D.maxPages, title: 'Extra pages from the sitemap'});
    p.value = (v && v.max_pages) || 0;
    return [u, p];
  }, D.maxSites, false);
  card(profile, {group: 'review', field: 'sites', title: 'Sites', wide: true, body: sites.body,
    help: 'Personal or portfolio sites to read. The number is how many extra pages to read from the site’s sitemap.xml; 0 reads the one page.',
    read: function(){
      return Array.prototype.map.call(sites.box.children, function(r){
        var f = r.querySelectorAll('input'); return {url: f[0].value, max_pages: f[1].value};
      });
    }, load: sites.load});
  [['linkedin_stale_days', 'LinkedIn export stale after (days)', 'An older export is flagged as stale.'],
   ['reevaluate_days', 'Re-judge at least every (days)', 'Even when no profile has changed.'],
   ['pursued_min_fit', 'Fit score for pursued roles', 'A role at or above this fit (0-100) counts as pursued, applied or not.'],
   ['pursued_window_days', 'Pursued roles from the last (days)', 'How far back pursued roles are read.']].forEach(function(n){
    var lim = D.limits[n[0]];
    var i = el('input', {type: 'number', cls: 'textfield', min: lim[0], max: lim[1]});
    i.value = S.review[n[0]];
    var host = D.trackerReview.indexOf(n[0]) >= 0 ? hosts.tracker : profile;
    card(host, {group: 'review', field: n[0], title: n[1], help: n[2] + ' (' + lim[0] + '–' + lim[1] + ')', body: i,
      read: function(){ return i.value; }, load: function(v){ i.value = v; }});
  });

  // ---- 04 Fit rules: the rules learned from your decisions, approved here.
  // Each approved rule is a row you can reword, re-file or remove. A pending
  // draft sits beneath, and "Adopt" copies a draft rule into the list above
  // (it is only saved, and only read by the model, once you press Save).
  function rulesCard(host, kind, title, help){
    var R = S.rules[kind], groups = R.groups;
    var list = el('div', {cls: 'rules'});
    var add = el('button', {type: 'button', cls: 'mini', text: '+ Add a rule'});
    var drafts = el('div', {cls: 'rules'});
    var body = el('div', {}, [list, el('div', {style: 'margin-top:8px'}, [add])]);

    function addRule(r, focus){
      var ta = el('textarea', {cls: 'textfield', maxlength: 600, rows: 2});
      ta.value = r.text || '';
      var sel = null;
      if(groups.length){
        sel = el('select', {title: 'Which way the rule leans'});
        groups.forEach(function(g){ var o = el('option', {text: g}); o.value = g; sel.appendChild(o); });
        sel.value = r.group || groups[0];
      }
      var del = el('button', {type: 'button', cls: 'mini', title: 'Remove', text: '×'});
      var row = el('div', {cls: 'row'}, [sel, ta, del]);
      var box = el('div', {cls: 'rule'}, [row, el('p', {cls: 'ev',
        text: r.evidence ? 'Evidence: ' + r.evidence : 'Written by you.'})]);
      box._r = {get: function(){ return {group: sel ? sel.value : null, text: ta.value, evidence: r.evidence || ''}; }};
      del.onclick = function(){ box.remove(); list.dispatchEvent(new Event('mc-change', {bubbles: true})); refresh(); };
      if(sel) sel.addEventListener('change', function(){ list.dispatchEvent(new Event('mc-change', {bubbles: true})); });
      list.appendChild(box);
      if(focus) ta.focus();
      return box;
    }
    function current(){ return Array.prototype.map.call(list.children, function(b){ return b._r.get(); }); }
    function load(rs){ list.innerHTML = ''; (rs || []).forEach(function(r){ addRule(r); }); refresh(); }

    function refresh(){
      var have = {}; current().forEach(function(r){ have[r.text.trim()] = true; });
      drafts.innerHTML = '';
      var d = R.draft || [];
      d.forEach(function(r){
        var done = !!have[r.text];
        var adopt = el('button', {type: 'button', cls: 'mini', text: done ? 'Adopted' : 'Adopt'});
        adopt.disabled = done;
        adopt.onclick = function(){
          addRule(r); list.dispatchEvent(new Event('mc-change', {bubbles: true})); refresh();
        };
        drafts.appendChild(el('div', {cls: 'rule pending' + (done ? ' adopted' : '')}, [
          el('div', {cls: 'row'}, [
            el('div', {style: 'flex:1;font-size:13px', text: (groups.length ? r.group + ': ' : '') + r.text}), adopt]),
          el('p', {cls: 'ev', text: r.evidence ? 'Evidence: ' + r.evidence : ''})]));
      });
      pendingHead.style.display = d.length ? '' : 'none';
      adoptAll.style.display = d.some(function(r){ return !have[r.text]; }) ? '' : 'none';
    }
    var adoptAll = el('button', {type: 'button', cls: 'mini', text: 'Adopt all'});
    adoptAll.onclick = function(){
      var have = {}; current().forEach(function(r){ have[r.text.trim()] = true; });
      (R.draft || []).forEach(function(r){ if(!have[r.text]) addRule(r); });
      list.dispatchEvent(new Event('mc-change', {bubbles: true})); refresh();
    };
    var summary = R.draft ? 'Draft from ' + R.draft_date + (R.draft_summary ? ' · ' + R.draft_summary : '') : '';
    var pendingHead = el('div', {cls: 'draftbox'}, [
      el('h4', {text: 'Pending draft'}), el('p', {cls: 'help', text: summary}), drafts,
      el('div', {style: 'margin-top:8px'}, [adoptAll])]);
    var notes = (R.draft_notes || []).concat(R.approved_notes || []);
    if(notes.length){
      var det = el('details', {cls: 'peek'}, [el('summary', {text: 'Patterns considered but not made into rules'}),
        el('pre', {text: notes.join('\n\n')})]);
      pendingHead.appendChild(det);
    }
    body.appendChild(pendingHead);
    add.onclick = function(){ addRule({group: groups[0] || null}, true); list.dispatchEvent(new Event('mc-change', {bubbles: true})); refresh(); };
    load(R.approved);
    card(host, {group: 'rules', field: kind, title: title, help: help, body: body, wide: true,
      read: current, load: load});
  }
  rulesCard(document.getElementById('rules-job'), 'learned', 'Learned preferences',
    'Rules drawn from the roles you pass on and pursue. The fit judge weighs them next to your profile. Reword, re-file or remove any rule; a draft is only used once you adopt it and Save.');
  rulesCard(document.getElementById('rules-profile'), 'guidance', 'Review guidance',
    'Rules drawn from the findings you dismiss. The profile reviewer will not raise a finding they rule out. A draft is only used once you adopt it and Save.');

  // Read-only until the dashboard answers, as on the other pages.
  function setLive(on){
    document.querySelectorAll('input, textarea, select').forEach(function(i){ i.disabled = !on; });
  }
  setLive(false);
  if(window.location.protocol === 'file:') return;
  fetch(API + '/api/health').then(function(r){ return r.ok ? r.json() : Promise.reject(); })
  .then(function(h){
    if(!h.ok) return;
    live = true; setLive(true);
    document.body.classList.add('live');
    document.getElementById('livebadge').style.display = 'inline-block';
    document.querySelectorAll('.card.dirty').forEach(function(c){ c.classList.remove('dirty'); });
  }).catch(function(){ /* read-only, as designed */ });

  // Unsaved edits are easy to lose on a page this long.
  window.addEventListener('beforeunload', function(e){
    if(live && document.querySelector('.card.dirty')){ e.preventDefault(); e.returnValue = ''; }
  });
})();
</script>
</body></html>
