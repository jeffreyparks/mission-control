<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Job Search Tracker — {{ d.date }}</title>
<link rel="stylesheet" href="theme.css">
<style>
  /* This page has ten columns plus two free-text inputs (Salary, Notes) - the
     shared 1180px .wrap from theme.css is cramped for it. Widened here only,
     so index.html and content-radar.html keep their narrower, read-first
     layout. */
  .wrap{max-width:min(1800px, 96vw)}
  /* More breathing room now that the canvas is wider. table-layout is auto,
     so a column only gets more space if something demands it - these
     min-widths are that demand. Notes gets the most room, since it holds
     free-form text rather than a short number. */
  th.salarycell, td.salarycell{min-width:130px}
  th.notescell, td.notescell{min-width:280px}
  .salarycell .textfield{max-width:140px}
  .notescell .textfield{max-width:340px}
  .tabs{display:flex;gap:8px;margin:22px 0 4px}
  .tab{font-size:13px;padding:8px 18px;border-radius:18px;border:1px solid var(--line);
    background:transparent;color:var(--ink-dim);cursor:pointer}
  .tab.on{background:var(--bg-card);color:var(--ink);border-color:var(--line)}
  .pane{display:none} .pane.on{display:block}
  .catbars{background:var(--bg-card);border:1px solid var(--line);border-radius:8px;padding:20px}
  .catbars .k{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--ink-mute);margin-bottom:14px}
  .cb{display:grid;grid-template-columns:1fr 90px 26px;gap:10px;align-items:center;
    font-size:12px;padding:3px 0}
  .cb .bar{height:5px;background:var(--line);border-radius:3px;overflow:hidden}
  .cb .bar i{display:block;height:100%;background:var(--accent)}
  .cb .n{text-align:right;color:var(--ink-dim);font-family:var(--mono);font-size:11px}
  .cb .lab{color:var(--ink-dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .layout{display:grid;grid-template-columns:1fr 340px;gap:14px;margin:24px 0}
  details.why{margin-top:5px}
  details.why summary{font-size:11px;color:var(--ink-mute);cursor:pointer;font-family:var(--mono);
    letter-spacing:.08em;text-transform:uppercase;list-style:none}
  details.why summary::-webkit-details-marker{display:none}
  details.why summary:hover{color:var(--accent)}
  details.why .body{font-size:12px;color:var(--ink-dim);padding:10px 0 4px;max-width:70ch}
  details.why .body b{color:var(--ink)}
  .rec{font-family:var(--mono);font-size:10px;padding:2px 7px;border-radius:3px;border:1px solid var(--line)}
  .rec.apply{color:var(--ok);border-color:#1f3d2a;background:#12211a}
  .rec.research{color:var(--warn);border-color:#4a3a15}
  .rec.skip{color:var(--ink-mute)}
  .count{font-size:11px;color:var(--ink-mute);font-family:var(--mono);margin:14px 0 6px}
  /* Machine-proposed role category. Deliberately dimmed: a proposal, not a fact. */
  .sugg{color:var(--ink-mute);opacity:.75;font-style:italic;display:inline-block;line-height:1.5}
  .sugg .chip-sugg{font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;
    font-style:normal;border:1px dashed var(--line);border-radius:3px;padding:1px 5px;margin-left:6px;
    color:var(--ink-mute);vertical-align:1px}
  .sugg.low{opacity:.5}
  /* Batch editing. The column and the bar exist in the static HTML but stay
     hidden until /api/health answers: with the server off there is nothing to
     write to, so an empty checkbox column would be a lie. */
  th.selcell,td.selcell{width:30px;padding-right:0;text-align:center}
  body:not(.live) th.selcell,body:not(.live) td.selcell{display:none}
  .selcell input{cursor:pointer}
  .bulkbar{display:none;align-items:center;gap:10px;flex-wrap:wrap;margin:12px 0 0;
    padding:10px 14px;background:var(--bg-card);border:1px solid var(--line);border-radius:8px}
  body.live .bulkbar{display:flex}
  .bulkbar .n{font-family:var(--mono);font-size:11px;color:var(--ink-dim);min-width:92px}
  .bulkbar .sep{color:var(--ink-mute);font-size:11px}
  .bulkbar .msg{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase}
  .bulkbar .msg.ok{color:var(--ok)} .bulkbar .msg.err{color:#ff6b6b}
  .bulkbtn{font-size:11px;font-family:var(--mono);letter-spacing:.06em;text-transform:uppercase;
    border:1px solid var(--line);background:transparent;color:var(--ink-dim);border-radius:14px;
    padding:5px 12px;cursor:pointer}
  .bulkbtn:hover{border-color:var(--accent);color:var(--accent)}
  .bulkbtn.go{color:var(--ink);border-color:var(--ink)}
  .bulkbtn:disabled{opacity:.4;cursor:default}
  @media(max-width:1000px){.layout{grid-template-columns:1fr}}
</style></head>
<body>

{% with page='tracker', subtitle='Job Search Tracker' %}{% include '_nav.html.j2' %}{% endwith %}

<div class="wrap">
  <header class="masthead" style="padding-bottom:22px">
    <h1 style="font-size:40px">Job Search Tracker</h1>
    <p class="standfirst">Every role opened for the AI &amp; measurement search, the fit read behind each one,
    and the company directory that sits under it.</p>
    <div class="chips" style="margin-top:18px">
      <span class="chip on">Refreshes daily</span>
      <span class="chip">Data as of {{ d.date }}</span>
      <span class="chip">{{ d.llm }}</span>
      <span class="chip live" id="livebadge" style="display:none">Editing on · serve.py</span>
    </div>
  </header>

  <div class="tabs">
    <button class="tab on" data-pane="roles">Roles</button>
    <button class="tab" data-pane="orgs">Orgs</button>
  </div>

  <div class="pane on" id="roles">
    <div class="kpis">
      <div class="kpi"><div class="k">Tracked</div><div class="v">{{ roles|length }}</div></div>
      <div class="kpi"><div class="k">Apply</div><div class="v" style="color:var(--ok)">{{ recs.apply }}</div></div>
      <div class="kpi"><div class="k">Research</div><div class="v" style="color:var(--warn)">{{ recs.research }}</div></div>
      <div class="kpi"><div class="k">Median fit</div><div class="v">{{ median_fit }}</div></div>
    </div>

    <div class="layout">
      <div class="catbars">
        <div class="k">By role category</div>
        {% for c, n in cats %}
        <div class="cb">
          <span class="lab">{{ c }}</span>
          <span class="bar"><i style="width:{{ (n / cats_max * 100)|round(0,'floor')|int }}%"></i></span>
          <span class="n">{{ n }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="catbars">
        <div class="k">By recommendation</div>
        {% for c, n in recbars %}
        <div class="cb">
          <span class="lab">{{ c }}</span>
          <span class="bar"><i style="width:{{ (n / roles|length * 100)|round(0,'floor')|int }}%"></i></span>
          <span class="n">{{ n }}</span>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="controls">
      <input type="search" id="q" placeholder="Search org, title, sector, or rationale…">
    </div>
    <div class="filterbar">
      <div class="fgroup">
        <span class="flabel">Rec</span>
        <div class="filters" id="recf">
          <button class="f on" data-rec="">All</button>
          <button class="f" data-rec="apply">Apply</button>
          <button class="f" data-rec="research">Research</button>
          <button class="f" data-rec="skip">Skip</button>
        </div>
      </div>
      <div class="fgroup">
        <span class="flabel">Status</span>
        <div class="filters" id="statusf">
          <button class="f on" data-status="">All</button>
          {% for s in statuses %}
          <button class="f" data-status="{{ s.value }}">{{ s.label }} <i>{{ s.count }}</i></button>
          {% endfor %}
        </div>
      </div>
    </div>
    <div class="count"><span id="shown">{{ roles|length }}</span> of {{ roles|length }} roles</div>

    <!-- Batch edit bar. Populated by the writeback script; invisible (and
         inert) when the server is not running. -->
    <div class="bulkbar" id="bulkbar">
      <span class="n"><b id="bulkcount">0</b> selected</span>
      <button type="button" class="bulkbtn" id="bulkall">Select all shown</button>
      <button type="button" class="bulkbtn" id="bulknone">Clear</button>
      <span class="sep">·</span>
      <span class="sep">Set</span>
      <select class="fieldsel" id="bulkfield"></select>
      <select class="fieldsel" id="bulkvalue"></select>
      <button type="button" class="bulkbtn go" id="bulkgo">Apply</button>
      <span class="msg" id="bulkmsg"></span>
    </div>

    <table id="rt">
      <thead><tr>
        <th class="selcell"><input type="checkbox" id="bulkhead" title="Select all shown"></th>
        <th>Org</th><th>Role</th><th>Category</th><th>Fit</th><th>Rec</th>
        <th>Pri</th><th>Status</th><th>Outcome</th><th class="salarycell">Salary</th><th class="notescell">Notes</th>
      </tr></thead>
      <tbody>
      {% for r in roles %}
        <tr data-rec="{{ r.recommendation or '' }}"
            data-status="{{ r.status or '' }}"
            data-id="{{ r.store_id or '' }}"
            data-blob="{{ (r.org ~ ' ' ~ r.title ~ ' ' ~ (r.sector or '') ~ ' ' ~ (r.role_cat or '') ~ ' ' ~ (r.suggested_role_cat or '') ~ ' ' ~ (r.suggestion_reason or '') ~ ' ' ~ (r.why or '') ~ ' ' ~ (r.seniority_read or ''))|lower }}">
          <td class="selcell"></td>
          <td><div class="org">{{ r.org }}</div><div class="sector">{{ r.sector or '—' }}</div></td>
          <td>
            {% if r.url %}<a href="{{ r.url }}" target="new" rel="noopener">{{ r.title }}</a>{% else %}{{ r.title }}{% endif %}
            {% if r.why %}
            <details class="why"><summary>Fit read</summary>
              <div class="body">
                <p><b>Seniority.</b> {{ r.seniority_read }}</p>
                <p><b>Why.</b> {{ r.why }}</p>
                {% if r.what_theyre_really_hiring_for %}<p><b>Really hiring for.</b> {{ r.what_theyre_really_hiring_for }}</p>{% endif %}
                {% if r.top_gaps %}<p><b>Gaps.</b> {{ r.top_gaps|join('; ') }}</p>{% endif %}
                {% if r.pitch_angle %}<p><b>Pitch angle.</b> {{ r.pitch_angle }}</p>{% endif %}
              </div>
            </details>
            {% endif %}
          </td>
          <td class="catcell" data-role-cat="{{ r.role_cat or '' }}"
              data-suggested="{{ r.suggested_role_cat or '' }}">
            {% if r.role_cat %}
              {{ r.role_cat }}
            {% elif r.suggested_role_cat %}
              <span class="sugg {{ r.suggestion_confidence or '' }}"
                    title="Suggested by the categoriser ({{ r.suggestion_confidence or 'unrated' }} confidence){% if r.suggestion_reason %}: {{ r.suggestion_reason }}{% endif %}">
                {{ r.suggested_role_cat }}<span class="chip-sugg">suggested</span>
              </span>
            {% else %}
              —
            {% endif %}
          </td>
          <td><span class="fit {% if (r.fit_score or 0) >= 70 %}hi{% elif (r.fit_score or 0) >= 45 %}mid{% else %}lo{% endif %}">{{ r.fit_score if r.fit_score is not none else '—' }}</span></td>
          <td class="reccell" data-rec-value="{{ r.recommendation or '' }}">{% if r.recommendation %}<span class="rec {{ r.recommendation }}">{{ r.recommendation }}</span>{% else %}—{% endif %}</td>
          <td class="pricell" data-pri-value="{{ r.priority|int if r.priority else '' }}">{% if r.priority %}<span class="pri p{{ r.priority|int }}">P{{ r.priority|int }}</span>{% else %}—{% endif %}</td>
          <td class="statuscell">{% if r.store_id %}<span class="dot {{ (r.status or '')|lower|replace('00 ','')|replace('01 ','')|replace('02 ','')|replace('03 ','')|replace('04 ','') }}">{{ r.status or '—' }}</span>{% else %}<span class="dot">—</span>{% endif %}</td>
          <td class="outcell" data-outcome-value="{{ r.outcome_label or '' }}">{% if r.outcome_display %}<span class="bad-chip">{{ r.outcome_display }}</span>{% else %}—{% endif %}</td>
          <td class="salarycell" data-text-value="{{ r.comp_range or '' }}">{{ r.comp_range or '—' }}</td>
          <td class="notescell" data-text-value="{{ r.notes or '' }}">{{ r.notes or '—' }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="pane" id="orgs">
    <div class="kpis">
      <div class="kpi"><div class="k">Organizations</div><div class="v">{{ orgs|length }}</div></div>
      <div class="kpi"><div class="k">With an apply</div><div class="v">{{ orgs_with_apply }}</div></div>
      <div class="kpi"><div class="k">Open roles</div><div class="v">{{ total_open }}</div></div>
      <div class="kpi"><div class="k">Best fit</div><div class="v">{{ best_fit }}</div></div>
    </div>
    <table>
      <thead><tr>
        <th>Organization</th><th>Roles</th><th>Open</th><th>Applied</th>
        <th>Best fit</th><th>Median</th><th>Strongest role</th><th>Outcomes</th>
      </tr></thead>
      <tbody>
      {% for o in orgs %}
        <tr>
          <td><div class="org">{{ o.org }}</div><div class="sector">{{ o.sector or '—' }}</div></td>
          <td>{{ o.role_count }}</td>
          <td>{{ o.open_count }}</td>
          <td>{{ o.applied_count }}</td>
          <td><span class="fit {% if (o.best_fit_score or 0) >= 70 %}hi{% elif (o.best_fit_score or 0) >= 45 %}mid{% else %}lo{% endif %}">{{ o.best_fit_score if o.best_fit_score is not none else '—' }}</span></td>
          <td class="sector">{{ o.median_fit_score if o.median_fit_score is not none else '—' }}</td>
          <td class="sector">{% if o.best_role %}{% if o.best_role.url %}<a href="{{ o.best_role.url }}" target="new" rel="noopener">{{ o.best_role.title }}</a>{% else %}{{ o.best_role.title }}{% endif %}{% else %}—{% endif %}</td>
          <td>{% if o.outcomes %}{% for x in o.outcomes %}<span class="bad-chip" title="{{ x.title }}">{{ x.outcome }}</span> {% endfor %}{% else %}—{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <footer>
    <span>Source of record: artifacts/jobs/org-roles-tracker.xlsx · intel-{{ d.date }}.json</span>
    <span>Mission Control · Job Search Tracker</span>
  </footer>
</div>

<script>
document.querySelectorAll('.tab').forEach(function(t){
  t.onclick=function(){
    document.querySelectorAll('.tab').forEach(function(x){x.classList.remove('on')});
    document.querySelectorAll('.pane').forEach(function(x){x.classList.remove('on')});
    t.classList.add('on');
    document.getElementById(t.dataset.pane).classList.add('on');
  };
});
var rec='', status='', q=document.getElementById('q');
function apply(){
  var term=q.value.trim().toLowerCase(), n=0;
  document.querySelectorAll('#rt tbody tr').forEach(function(tr){
    var okRec = !rec || tr.dataset.rec===rec;
    var okStatus = !status || tr.dataset.status===status;
    var okQ = !term || tr.dataset.blob.indexOf(term)!==-1;
    var show = okRec && okStatus && okQ;
    tr.style.display = show ? '' : 'none';
    // A hidden row drops out of the selection: "apply to selected" must only
    // ever touch rows the user can actually see at the moment they click it.
    if(!show && window.mcBulk) window.mcBulk.deselect(tr);
    if(show) n++;
  });
  document.getElementById('shown').textContent=n;
  if(window.mcBulk) window.mcBulk.refresh();
}
q.oninput=apply;
// One handler for both filter rows: the group id decides which variable moves,
// so adding another facet later means adding one line, not another block.
[['recf','rec'],['statusf','status']].forEach(function(pair){
  var group=document.getElementById(pair[0]);
  if(!group) return;
  group.querySelectorAll('.f').forEach(function(b){
    b.onclick=function(){
      group.querySelectorAll('.f').forEach(function(x){x.classList.remove('on')});
      b.classList.add('on');
      if(pair[1]==='rec'){ rec=b.dataset.rec; } else { status=b.dataset.status; }
      apply();
    };
  });
});

// ---------------------------------------------------------------------------
// Optional writeback. The page is a static file first: if serve.py is not
// running, /api/health fails, nothing below happens, and the table stays
// read-only exactly as rendered.
// ---------------------------------------------------------------------------
(function(){
  var API = window.location.origin;
  if(window.location.protocol === 'file:') return;

  // field -> {role id -> setter}. Filled in as each column is made editable,
  // read by the batch bar so a bulk write can move the single-row controls to
  // their new value without re-rendering the page.
  var controls = {};

  fetch(API + '/api/health').then(function(r){
    return r.ok ? r.json() : Promise.reject();
  }).then(function(health){
    if(!health.ok || !health.editable) return;
    document.body.classList.add('live');
    var banner = document.getElementById('livebadge');
    if(banner) banner.style.display = 'inline-block';
    var ed = health.editable;
    if(ed.status) enableSelect('statuscell', 'status', ed.status, function(tr,v){ tr.dataset.status=v; apply(); },
      function(v){ return v.replace(/^\d\d\s/, ''); }, function(tr,cell){ return tr.dataset.status || ''; });
    if(ed.priority) enableSelect('pricell', 'priority', ed.priority, function(tr,v){},
      function(v){ return v ? 'P'+v : '\u2014'; }, function(tr,cell){ return cell.dataset.priValue || ''; });
    if(ed.recommendation) enableSelect('reccell', 'recommendation', ed.recommendation, function(tr,v){ tr.dataset.rec=v; apply(); },
      function(v){ return v || '\u2014'; }, function(tr,cell){ return tr.dataset.rec || ''; });
    if(ed.outcomes) enableSelect('outcell', 'outcomes', ed.outcomes, function(tr,v){},
      function(v){ return v || '\u2014'; }, function(tr,cell){ return cell.dataset.outcomeValue || ''; });
    if(ed.role_cat) enableCategoryEditing(ed.role_cat);
    // Free-text fields report their vocabulary as null (any text is
    // accepted), so presence in the object - not truthiness - is the signal.
    if('notes' in ed) enableTextField('notescell', 'notes');
    if('comp_range' in ed) enableTextField('salarycell', 'comp_range');
    enableBatchEditing(ed);
  }).catch(function(){ /* read-only, as designed */ });

  // One generic editor for a single-select field: status, priority,
  // recommendation, outcomes. Category is different enough (freeform
  // suggestion acceptance) to get its own function below.
  function enableSelect(cellClass, field, options, onSaved, labelFor, currentFor){
    document.querySelectorAll('#rt tbody tr').forEach(function(tr){
      var id = tr.dataset.id;
      var cell = tr.querySelector('.' + cellClass);
      if(!id || !cell) return;
      var current = currentFor(tr, cell);

      var sel = document.createElement('select');
      sel.className = 'fieldsel';
      options.forEach(function(value){
        var opt = document.createElement('option');
        opt.value = value;
        opt.textContent = labelFor(value);
        if(value === current) opt.selected = true;
        sel.appendChild(opt);
      });

      sel.onchange = function(){
        var next = sel.value, previous = current;
        writeField(id, field, next, sel, cell, function(){
          current = next;
          onSaved(tr, next);
        }, function(){ sel.value = previous; });
      };

      if(!controls[field]) controls[field] = {};
      controls[field][id] = function(next){   // a batch write landed on this row
        current = next;
        sel.value = next;
        flash(cell, 'saved');
        onSaved(tr, next);
      };

      cell.innerHTML = '';
      cell.appendChild(sel);
    });
  }

  // Category gets a select PLUS a one-click "use" action when the categoriser
  // has a suggestion the user has not accepted or overridden yet.
  function enableCategoryEditing(options){
    document.querySelectorAll('#rt tbody tr').forEach(function(tr){
      var id = tr.dataset.id;
      var cell = tr.querySelector('.catcell');
      if(!id || !cell) return;
      var current = cell.dataset.roleCat || '';
      var suggested = cell.dataset.suggested || '';

      var wrap = document.createElement('div');
      var sel = document.createElement('select');
      sel.className = 'fieldsel catsel';
      options.forEach(function(value){
        var opt = document.createElement('option');
        opt.value = value;
        opt.textContent = value || '\u2014 none \u2014';
        if(value === current) opt.selected = true;
        sel.appendChild(opt);
      });
      sel.onchange = function(){
        var next = sel.value, previous = current;
        writeField(id, 'role_cat', next, sel, cell, function(){
          current = next;
          hint.style.display = 'none';
        }, function(){ sel.value = previous; });
      };
      if(!controls.role_cat) controls.role_cat = {};
      controls.role_cat[id] = function(next){
        current = next;
        sel.value = next;
        hint.style.display = 'none';
        flash(cell, 'saved');
      };
      wrap.appendChild(sel);

      var hint = document.createElement('div');
      hint.className = 'accept-hint';
      if(!current && suggested){
        hint.innerHTML = 'suggested: <b>' + suggested + '</b> ';
        var use = document.createElement('button');
        use.type = 'button';
        use.className = 'accept-btn';
        use.textContent = 'accept';
        use.onclick = function(){
          sel.value = suggested;
          sel.dispatchEvent(new Event('change'));
        };
        hint.appendChild(use);
      } else {
        hint.style.display = 'none';
      }
      wrap.appendChild(hint);

      cell.innerHTML = '';
      cell.appendChild(wrap);
    });
  }

  // Free-text field (Notes, Salary): a plain input, committed on blur or
  // Enter - not on every keystroke, so a partial word in progress is never
  // sent. Escape reverts to the last saved value without writing anything.
  function enableTextField(cellClass, field){
    document.querySelectorAll('#rt tbody tr').forEach(function(tr){
      var id = tr.dataset.id;
      var cell = tr.querySelector('.' + cellClass);
      if(!id || !cell) return;
      var current = cell.dataset.textValue || '';

      var input = document.createElement('input');
      input.type = 'text';
      input.className = 'textfield';
      input.value = current;
      input.placeholder = '—';

      function commit(){
        var next = input.value.trim();
        if(next === current){ return; }
        writeField(id, field, next, input, cell, function(){
          current = next;
        }, function(){ input.value = current; });
      }
      input.onblur = commit;
      input.onkeydown = function(e){
        if(e.key === 'Enter'){ input.blur(); }
        if(e.key === 'Escape'){ input.value = current; input.blur(); }
      };

      cell.innerHTML = '';
      cell.appendChild(input);
    });
  }

  // Batch editing: tick some rows, pick a field and a value, write them all in
  // one request. The motivating case is the end of a triage pass - filter to
  // Rec = skip, select all shown, set Status = 04 Closed - which is otherwise
  // dozens of identical dropdown changes.
  //
  // Only closed-vocabulary fields are offered. Notes and Salary are free text
  // and per-role by nature; mass-overwriting them is far more likely to be an
  // accident than an intention, so the bar does not allow it.
  function enableBatchEditing(ed){
    var bar = document.getElementById('bulkbar');
    if(!bar) return;
    var fieldSel = document.getElementById('bulkfield'),
        valueSel = document.getElementById('bulkvalue'),
        go = document.getElementById('bulkgo'),
        msg = document.getElementById('bulkmsg'),
        countEl = document.getElementById('bulkcount'),
        head = document.getElementById('bulkhead');

    var OFFER = [['status', 'Status'], ['priority', 'Priority'],
                 ['outcomes', 'Outcome'], ['role_cat', 'Category']];
    var fields = OFFER.filter(function(f){ return ed[f[0]] && ed[f[0]].length; });
    if(!fields.length){ bar.style.display = 'none'; return; }

    fields.forEach(function(f){
      var opt = document.createElement('option');
      opt.value = f[0]; opt.textContent = f[1];
      fieldSel.appendChild(opt);
    });

    function labelFor(field, value){
      if(!value) return '\u2014 none \u2014';
      if(field === 'status') return value.replace(/^\d\d\s/, '');
      if(field === 'priority') return 'P' + value;
      return value;
    }
    function fillValues(){
      valueSel.innerHTML = '';
      (ed[fieldSel.value] || []).forEach(function(value){
        var opt = document.createElement('option');
        opt.value = value; opt.textContent = labelFor(fieldSel.value, value);
        valueSel.appendChild(opt);
      });
    }
    fieldSel.onchange = function(){ fillValues(); say(''); };
    fillValues();

    // One checkbox per writable row. Rows with no store_id cannot be written
    // at all, so they get no checkbox and can never end up in a batch.
    var boxes = [];
    document.querySelectorAll('#rt tbody tr').forEach(function(tr){
      var id = tr.dataset.id, cell = tr.querySelector('.selcell');
      if(!id || !cell) return;
      var box = document.createElement('input');
      box.type = 'checkbox';
      box.onchange = refresh;
      cell.innerHTML = '';
      cell.appendChild(box);
      boxes.push({tr: tr, id: id, box: box});
    });

    function visible(entry){ return entry.tr.style.display !== 'none'; }
    function selected(){
      return boxes.filter(function(e){ return e.box.checked && visible(e); });
    }
    function say(text, kind){
      msg.textContent = text;
      msg.className = 'msg' + (kind ? ' ' + kind : '');
    }
    function refresh(){
      var n = selected().length, shown = boxes.filter(visible).length;
      countEl.textContent = n;
      go.disabled = n === 0;
      head.checked = n > 0 && n === shown;
      head.indeterminate = n > 0 && n < shown;
    }

    function setAll(state){
      boxes.forEach(function(e){ if(visible(e)) e.box.checked = state; });
      refresh();
    }
    head.onchange = function(){ setAll(head.checked); };
    document.getElementById('bulkall').onclick = function(){ setAll(true); };
    document.getElementById('bulknone').onclick = function(){
      boxes.forEach(function(e){ e.box.checked = false; });
      refresh();
    };

    go.onclick = function(){
      var chosen = selected(), field = fieldSel.value, value = valueSel.value;
      if(!chosen.length) return;
      go.disabled = true;
      say('saving\u2026');
      fetch(API + '/api/roles/bulk', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ids: chosen.map(function(e){ return e.id; }),
                              field: field, value: value})
      }).then(function(r){ return r.json(); }).then(function(res){
        if(res.error){ throw new Error(res.error); }
        (res.results || []).forEach(function(row){
          if(row.error) return;
          var setter = (controls[field] || {})[row.id];
          if(setter) setter(value);
        });
        boxes.forEach(function(e){ e.box.checked = false; });
        var text = res.changed + ' updated';
        if(res.unchanged) text += ', ' + res.unchanged + ' already set';
        if(res.failed) text += ', ' + res.failed + ' failed';
        say(text, res.failed ? 'err' : 'ok');
        apply();          // also refreshes the selection state
      }).catch(function(err){
        say('failed: ' + err.message, 'err');
        console.error('bulk writeback failed', field, err);
      }).then(function(){ refresh(); });
    };

    // apply() (the filter pass) calls back in here, so hiding a row also drops
    // it from the selection and the count stays honest.
    window.mcBulk = {
      deselect: function(tr){
        boxes.forEach(function(e){ if(e.tr === tr) e.box.checked = false; });
      },
      refresh: refresh
    };
    refresh();
  }

  function writeField(id, field, value, control, cell, onSuccess, onFailure){
    control.disabled = true;
    fetch(API + '/api/role/' + encodeURIComponent(id), {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({field: field, value: value})
    }).then(function(r){ return r.json(); }).then(function(res){
      control.disabled = false;
      if(res.error){ throw new Error(res.error); }
      onSuccess();
      flash(cell, 'saved');
    }).catch(function(err){
      control.disabled = false;
      onFailure();
      flash(cell, 'failed');
      console.error('writeback failed', field, err);
    });
  }

  function flash(cell, kind){
    var tag = document.createElement('span');
    tag.className = 'flash ' + kind;
    tag.textContent = kind;
    cell.appendChild(tag);
    setTimeout(function(){ tag.remove(); }, 1600);
  }
})();
</script>
</body></html>
