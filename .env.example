# Mission Control - MACHINE-WIDE secrets, shared by every workspace.
# Copy this file to .env in the repo root and fill in what you use.
# .env is gitignored - never commit real values.
#
# Per-person identity does NOT belong here. Whose GitHub/BlueSky a run scans
# lives in workspace/<name>/.env, so `mc run --user someone-else` can never
# scan your accounts. See templates/workspace.env.example.

# ---- LLM backend ----
# "cli"  (default) - use the local `claude` CLI, billed to your Claude subscription.
#                      Requires `claude` installed and logged in (`claude login`).
# "api"  - call the Anthropic API directly with ANTHROPIC_API_KEY, billed per token.
LLM_BACKEND=api

# Required only when LLM_BACKEND=api
ANTHROPIC_API_KEY=

# Cheap open-weight models for mechanical/bulk routing tiers (T1-T3).
# Get a key at https://openrouter.ai/keys - optional, routing falls back to
# the claude backend above if unset.
OPENROUTER_API_KEY=

# ---- Profile scanner identity ----
# NOT here. These live per person in workspace/<name>/.env:
#   GITHUB_USERNAME, BLUESKY_HANDLE, BLUESKY_APP_PASSWORD, BLUESKY_PDS_URL
# `uv run setup.py --user NAME` writes them to the right file for you.

# ---- Model ladder by tier ----
# Which model each tier is. config/model-routing.toml says which tier a call
# starts at; a call that fails validation escalates to the next tier.
# An "openrouter/" prefix goes to OpenRouter; anything else is a Claude model,
# reached by CLI or API according to LLM_BACKEND above.
MC_TIER_ORDER=T1,T2,T3,T4
MC_MODEL_T1=openrouter/qwen/qwen3-30b-a3b-instruct-2507
MC_MODEL_T2=openrouter/openai/gpt-oss-120b
MC_MODEL_T3=claude-sonnet-5
MC_MODEL_T4=claude-opus-5
