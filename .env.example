# Mission Control - environment secrets.
# Copy this file to .env in the repo root and fill in what you use.
# .env is gitignored - never commit real values.

# ---- LLM backend ----
# "cli"  (default) - use the local `claude` CLI, billed to your Claude subscription.
#                      Requires `claude` installed and logged in (`claude login`).
# "api"  - call the Anthropic API directly with ANTHROPIC_API_KEY, billed per token.
LLM_BACKEND=cli

# Required only when LLM_BACKEND=api
ANTHROPIC_API_KEY=

# Cheap open-weight models for mechanical/bulk routing tiers (T1-T3).
# Get a key at https://openrouter.ai/keys - optional, routing falls back to
# the claude backend above if unset.
OPENROUTER_API_KEY=

# ---- Profile scanners (all optional - scans are skipped if unset) ----
GITHUB_USERNAME=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Leave blank for standard bsky.social. Set only for a custom PDS.
BLUESKY_PDS_URL=
