# Agents + Misc
.DS_Store
.agents/
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.Python

# IDE
.vscode/
.idea/

# Mission Control
artifacts/content/*
artifacts/history/*
data/llm-cache/*.json
history.db


# Credentials (NEVER COMMIT)
config/*.conf
config/*credentials*
config/*password*
*.env

# Generated tracker backups (the xlsx export and the db are the record)
artifacts/jobs/org-roles-tracker-backup-*.xlsx

# SQLite sidecars
*.db-wal
*.db-shm

# Daily run bookkeeping
logs/
data/last-daily-run.txt

# User data (career/job-search content - local record only, not upstream)
artifacts/jobs/
artifacts/profiles/
artifacts/samples/
artifacts/html/*.html
data/job-descriptions.json
data/mission-control.db
data/org-sectors.json
data/role-categories.json

# Personal onboarding data - single input folder, local machine only.
# templates/me/ (the placeholders) stays tracked; me/ (your real data) never does.
/me/

# Scratch: probes, one-off repairs, pre-migration copies
attic/_*.py
attic/*.xlsx
attic/eval-routing*.json
