# Agents + Misc
.DS_Store
.agents/
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.Python

# IDE
.vscode/
.idea/

# Mission Control - ALL user data lives in workspace/<name>/, one dir per person.
# That single line replaces the old scattered artifacts/ data/ me/ entries.
workspace/


# Credentials (NEVER COMMIT)
config/*.conf
config/*credentials*
config/*password*
*.env

# SQLite sidecars
*.db-wal
*.db-shm

# Daily run bookkeeping
logs/

# mc CLI runtime state (dashboard pidfile/log)
/.mc/

# One-time safety copy from the workspace/ migration
.migration-backup/

# Scratch: probes, one-off repairs, pre-migration copies
attic/_*.py
attic/*.xlsx
attic/eval-routing*.json
