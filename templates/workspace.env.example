# Identity for ONE workspace: copy to workspace/<name>/.env
#
# These say whose public accounts a run for this person scans. They are
# deliberately per-workspace, so `mc run --user someone-else` reads their file
# and never yours. All optional - a scan is skipped when its value is blank.
#
# Machine-wide secrets (LLM_BACKEND, ANTHROPIC_API_KEY, OPENROUTER_API_KEY)
# do NOT go here - they stay in the repo-root .env, shared by every workspace.

GITHUB_USERNAME=
BLUESKY_HANDLE=
# Optional. Public posts are read without logging in; the password is only a
# fallback if the public read fails. Leave blank unless that happens.
BLUESKY_APP_PASSWORD=
# Only used with the app password above, for a custom PDS.
BLUESKY_PDS_URL=
